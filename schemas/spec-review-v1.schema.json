{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_manifest_sha256",
    "current_documents",
    "section_traces"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "base_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "current_documents": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "section_traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "heading",
          "kind",
          "requirements",
          "sha256"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "normative",
              "informative",
              "example",
              "recommendation"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[^#]+#[A-Z0-9-]+$"
            },
            "uniqueItems": true
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
